{
  "name": "lazy-bookmark",
  "description": "Live grep through bookmarks with LazySth like interface using leader key",
  "private": false,
  "author": "GyeongHoKim",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/GyeongHoKim/gyeongho-bookmark-telescope"
  },
  "homepage": "https://github.com/GyeongHoKim/gyeongho-bookmark-telescope",
  "bugs": {
    "url": "https://github.com/GyeongHoKim/gyeongho-bookmark-telescope/issues"
  },
  "keywords": [
    "chrome-extension",
    "bookmark-telescope",
    "nvim-telescope",
    "chrome-extension-template"
  ],
  "contributors": [
    {
      "name": "GyeongHoKim",
      "email": "rlarudgh2017@gmail.com",
      "url": "https://github.com/GyeongHoKim"
    }
  ],
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write \"entrypoints/**/*.{ts,tsx}\"",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@xstate/react": "^6.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "xstate": "^5.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/dom-chromium-ai": "^0.0.10",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.3",
    "@typescript-eslint/eslint-plugin": "^8.44.0",
    "@typescript-eslint/parser": "^8.44.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@webext-core/fake-browser": "^1.3.2",
    "@wxt-dev/module-react": "^1.1.3",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "happy-dom": "^18.0.1",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.44.0",
    "vitest": "^3.2.4",
    "wxt": "^0.20.6"
  }
}
